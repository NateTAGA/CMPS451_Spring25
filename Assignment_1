#include <iostream>
#include <vector>
#include <cmath>
#include <cstdlib>
#include <ctime>
#include <limits>
#include <algorithm>

using namespace std;
// K-means clustering algorithm in C++
// 1.  2D points
class Point {
public:
    double x, y;
    int cluster; // Cluster ID
    
    Point(double x, double y) : x(x), y(y), cluster(-1) {}
    
    double distanceTo(const Point& other) const {
        return sqrt(pow(x - other.x, 2) + pow(y - other.y, 2));
    }
};

// 2. K-means clustering implementation
class KMeans {
private:
    int k;
    vector<Point> points;
    vector<Point> centroids;
    
    void initializeCentroids() {
        centroids.clear();
        vector<Point> tempPoints = points;
            
        for (int i = 0; i < k; ++i) {
            centroids.push_back(tempPoints[i]);
        }
    }
    
    void assignClusters() {
        for (Point& point : points) {
            double minDist = numeric_limits<double>::max();
            for (int i = 0; i < centroids.size(); ++i) {
                double dist = point.distanceTo(centroids[i]);
                if (dist < minDist) {
                    minDist = dist;
                    point.cluster = i;
                }
            }
        }
    }
    
    void updateCentroids() {
        vector<double> sumX(k, 0.0);
        vector<double> sumY(k, 0.0);
        vector<int> counts(k, 0);
        
        for (const Point& p : points) {
            sumX[p.cluster] += p.x;
            sumY[p.cluster] += p.y;
            counts[p.cluster]++;
        }
        
        for (int i = 0; i < k; ++i) {
            if (counts[i] > 0) {
                centroids[i].x = sumX[i] / counts[i];
                centroids[i].y = sumY[i] / counts[i];
            }
        }
    }
    
public:
    KMeans(int k, const vector<Point>& points) : k(k), points(points) {
        srand(time(NULL));
    }
    
    void run(int maxIterations = 100) {
        initializeCentroids();
        
        for (int iter = 0; iter < maxIterations; ++iter) {
            vector<Point> oldCentroids = centroids;
            assignClusters();
            updateCentroids();
            
            // Check for convergence
            bool converged = true;
            for (int i = 0; i < k; ++i) {
                if (centroids[i].x != oldCentroids[i].x || centroids[i].y != oldCentroids[i].y) {
                    converged = false;
                    break;
                }
            }
            if (converged) break;
        }
    }
    
    const vector<Point>& getResults() const { return points; }
    const vector<Point>& getCentroids() const { return centroids; }
};

// 3. Main function with example usage
int main() {
    // Sample data (3 clear clusters)
    vector<Point> dataset = {
        {2.0, 3.0}, {2.5, 4.5}, {1.5, 2.5},  // Cluster 0
        {6.0, 5.0}, {7.0, 7.0}, {5.5, 5.5},  // Cluster 1
        {9.0, 2.0}, {10.0, 3.5}, {9.5, 2.5}  // Cluster 2
    };
    
    // Create and run K-means
    KMeans kmeans(3, dataset);
    kmeans.run();
    
    // Print results
    cout << "Cluster Assignments:\n";
    for (const Point& p : kmeans.getResults()) {
        std::cout << "(" << p.x << ", " << p.y << ") -> Cluster " << p.cluster << "\n";
    }
    
    cout << "\nFinal Centroids:\n";
    for (const Point& c : kmeans.getCentroids()) {
        cout << "Cluster " << c.cluster << ": (" << c.x << ", " << c.y << ")\n";
    }
    
    return 0;
}
